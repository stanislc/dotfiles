[user]
	name = stanislc
	email = cherepanov.st@gmail.com
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
# Machine-specific overrides (work identity, credential helpers, safe.directory).
[include]
	path = ~/.gitconfig.local
